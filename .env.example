# Copy these into Render > Environment. Never commit real keys.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ADMIN_KEY=
PAYHERO_API_KEY=
PAYHERO_API_SECRET=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_SECRET=
CALLBACK_URL=https://YOUR-SITE.onrender.com/api/webhooks/payhero?s=YOUR_CALLBACK_SECRET
PAYHERO_PROVIDER=m-pesa
WHATSAPP_NUMBER=2547XXXXXXXX
ALLOWED_ORIGINS=
HOLD_MINUTES=10
# Leave empty to use the default gateway host. PayHero's published API host is https://backend.payhero.co.ke
PAYHERO_BASE_URL=https://backend.payhero.co.ke
# Tickets are emailed with Resend. MAIL_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Greenline Buses <tickets@yourdomain.co.ke>
SITE_URL=https://YOUR-SITE.onrender.com
